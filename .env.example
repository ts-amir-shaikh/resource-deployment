# ─── Authentication (required) ───────────────────────────────────────────
# Shared password for the team. Anyone with this can see all client and
# compensation data, so treat it like a credential.
APP_PASSWORD=change-me

# Signs the session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# ─── Database ────────────────────────────────────────────────────────────
# Leave both unset for local development — the app falls back to a local
# libSQL file at ./data/deployment.db.
#
# For production, create a Turso database and paste its values here:
#   turso db create resource-deployment
#   turso db show resource-deployment --url
#   turso db tokens create resource-deployment
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Agents (Phase 7) ────────────────────────────────────────
# Required for the Agents tab. Create at console.anthropic.com.
# Server-side only — never expose to the browser.
ANTHROPIC_API_KEY=

# Monthly ceiling in USD across all agent runs. Runs are refused once the
# month-to-date spend reaches it. Leave blank or 0 for no cap.
AGENT_MONTHLY_CAP_USD=50

# ── Email: password links (accounts and sign-in) ───────────────────────────
# Sent from a Google Workspace mailbox over SMTP with an app password.
# The mailbox needs 2-step verification switched on; then create an app
# password at myaccount.google.com/apppasswords. Server-side only.
# Without these, Send link reports "Email is not configured" and sends nothing.
MAIL_USER=
MAIL_APP_PASSWORD=
# Optional display sender, e.g.  Techstalwarts Staffing <no-reply@techstalwarts.com>
MAIL_FROM=

# ── Google sign-in (accounts and sign-in) ──────────────────────────────────
# Anyone whose Google address (Gmail or techstalwarts.com) matches an account's
# email can sign in with Google. Create an OAuth client of type "Web
# application" in Google Cloud Console → APIs & Services → Credentials, and
# set the OAuth consent screen's audience to External, or Gmail addresses are
# refused. Authorised redirect URI, exactly:
#   <APP_BASE_URL>/api/auth/google/callback
# Leave any of these blank and the Google button is hidden.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The public address people open, no trailing slash, e.g.
#   https://staffing.techstalwarts.com   (production)
#   http://localhost:3000                (local)
# Also used for the links in password emails.
APP_BASE_URL=
